# Supabase PostgreSQL Connection Strings
# Transaction pooler (Port 6543) with pgbouncer and single connection limit for serverless functions
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (Port 5432) used for Prisma migrations and schema pushes
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sudo_update_dev_secret_replace_in_production_key_32chars_minimum"

# GitHub OAuth App
GITHUB_ID="your_github_client_id"
GITHUB_SECRET="your_github_client_secret"

# Google OAuth Client
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Root Admin Authorization Filter
ADMIN_EMAIL="root@sudoupdate.dev"
